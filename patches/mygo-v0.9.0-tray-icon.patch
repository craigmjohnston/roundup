+// SetHighlightedIcon sets an icon in color to show in place of the icon
+// while the tray icon is highlighted: pressed, or while its menu or flyout
+// shows (macOS). It should be the icon's size; nil shows the icon itself.
+func (t *Tray) SetHighlightedIcon(png []byte) error {
+	var err error
+	t.do(func(n platform.Tray) {
+		if h, ok := n.(interface{ SetAlternateImage([]byte) error }); ok {
+			err = h.SetAlternateImage(png)
+		}
+	})
+	return err
+}
