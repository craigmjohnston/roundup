+// cellContentsMask is NSContentsCellMask.
+const cellContentsMask = 1
+
+// SetAlternateImage sets the image in color that AppKit shows instead of the
+// item's image while the item is highlighted; nil shows the image itself.
+func (t *tray) SetAlternateImage(png []byte) error {
+	var err error
+	withPool(func() {
+		if png == nil {
+			send(t.button, "setAlternateImage:", 0)
+			return
+		}
+		img := autorelease(send(send(class("NSImage"), "alloc"), "initWithData:", uintptr(nsData(png))))
+		if img == 0 {
+			err = errInvalidImage
+			return
+		}
+		send(t.button, "setAlternateImage:", uintptr(img))
+		// A button cell shows its alternate image only when it highlights by its contents.
+		cell := send(t.button, "cell")
+		send(cell, "setHighlightsBy:", uintptr(sendInt(cell, "highlightsBy")|cellContentsMask))
+	})
+	return err
+}
